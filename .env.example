# ---------------------------------------------------------------- core (web)
# Postgres (Neon pooled URL). Leave empty locally to use embedded PGlite under node_modules/.cache.
DATABASE_URL=
# Run migrations automatically on first request (otherwise: npm run db:migrate)
AUTO_MIGRATE=0
# Puzzle #1 date (a Monday). Numbers: daysBetween(LAUNCH_DATE, date) + 1
LAUNCH_DATE=2027-01-04
# Secrets (32+ random bytes each; required on production deploys)
DEVICE_PEPPER=
TRANSFER_KEY=
REDIS_SECRET_KEY=
CRON_SECRET=
# Feature flags JSON (§4.7), e.g. {"dailyLimitMode":"per_game","gamesDisabled":["bar:jargon"]}
FEATURE_FLAGS=
# Fixtures + dev date override on non-production builds (preview deploys)
FIXTURES=0
# Set on the production deployment (Vercel sets VERCEL_ENV automatically)
PREPDLE_PRODUCTION=0

# ---------------------------------------------------------------- rate limits / warm cache (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- staff auth (admin console)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails auto-provisioned as admins on first sign-in
ADMIN_EMAILS=

# ---------------------------------------------------------------- observability
ALERT_WEBHOOK_URL=
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_SHARE_DOMAIN=prepdle.app

# ---------------------------------------------------------------- pipeline only (never set on the web app)
ANTHROPIC_API_KEY=
PREPDLE_MODEL=claude-opus-5-5
PREPDLE_SOLVER_MODEL=claude-sonnet-5-5
OPENFDA_API_KEY=
GOVINFO_API_KEY=
COURTLISTENER_TOKEN=

# ---------------------------------------------------------------- content approval (pipeline)
# Launch window: approve every validated item with no failing check (warnings allowed) until this date,
# then fall back to strict auto-approval (all checks pass). Failing items are never auto-approved.
AUTO_APPROVE_LAUNCH_UNTIL=
AUTO_APPROVE_VALIDATED=1
