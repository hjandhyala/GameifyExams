{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/buffer-check",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/lock-window",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron/warm-secrets",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/aggregates-reconcile",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/psychometrics",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/prune",
      "schedule": "0 4 * * 0"
    }
  ],
  "regions": [
    "cle1"
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}