{
  "name": "gameifyexams",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @prepdle/web",
    "build": "npm run build -w @prepdle/web",
    "start": "npm run start -w @prepdle/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p packages/db && tsc -p packages/pipeline && tsc -p apps/web --noEmit",
    "e2e": "playwright test",
    "pipeline": "tsx packages/pipeline/src/cli.ts",
    "db:migrate": "tsx packages/pipeline/src/cli.ts migrate",
    "db:seed": "tsx packages/pipeline/src/cli.ts seed-fixtures"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.10.0",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
